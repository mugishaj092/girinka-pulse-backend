# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=girinka.settings.development

# Database (PostgreSQL — also acts as Celery broker, no Redis needed)
DB_NAME=girinka-pulse-db
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432
DATABASE_SSL=prefer

# Celery broker — uses PostgreSQL directly
CELERY_BROKER_URL=db+postgresql://postgres:yourpassword@localhost/girinka-pulse-db

# JWT
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudinary (file/image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (email)
RESEND_API_KEY=re_your_key
FROM_EMAIL=Girinka Pulse <no-reply@yourdomain.com>

# ML Service
ML_SERVICE_URL=https://girinka-pulse-ml.onrender.com
ML_SERVICE_API_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sentry (optional)
SENTRY_DSN=
