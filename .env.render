# ============================================================================
# Girinka Pulse — Render Environment Variables Template
# ============================================================================
# Copy these to Render Dashboard → Service → Environment
# Replace <placeholders> with actual values
# ============================================================================

# ── Python & Django ─────────────────────────────────────────────────────────
PYTHON_VERSION=3.12.0
DJANGO_SETTINGS_MODULE=girinka.settings.production
DEBUG=False

# ── Security ────────────────────────────────────────────────────────────────
# Generate a random 50-character string for SECRET_KEY
# Use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<generate-random-secret-key-here>

# ── Database ────────────────────────────────────────────────────────────────
# Get this from Render Dashboard → Database → Internal Database URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=<paste-internal-database-url-from-render>

# ── Allowed Hosts & CORS ────────────────────────────────────────────────────
ALLOWED_HOSTS=.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,https://your-frontend-domain.com

# ── Cloudinary (File Storage) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=dhforyx1s
CLOUDINARY_API_KEY=577771784241754
CLOUDINARY_API_SECRET=nWNOam5NoSZsVq_E4ySFfFZ12fk

# ── Resend (Email Service) ──────────────────────────────────────────────────
RESEND_API_KEY=re_JHLc6JkY_A72P6uHPbXxru9esC9myLZdQ
FROM_EMAIL=Girinka Pulse <no-reply@mugishajoseph.me>

# ── ML Service ──────────────────────────────────────────────────────────────
ML_SERVICE_URL=https://girinka-pulse-ml.onrender.com
ML_SERVICE_API_KEY=

# ── SSL & Security Headers ──────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True

# ── Sentry (Optional - Error Tracking) ──────────────────────────────────────
SENTRY_DSN=

# ── JWT Token Lifetimes (Optional) ──────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ============================================================================
# Service-Specific Variables
# ============================================================================

# API Service (Web Service)
# -------------------------
# Needs ALL variables above

# Celery Worker (Background Worker)
# ----------------------------------
# Needs:
# - PYTHON_VERSION
# - DJANGO_SETTINGS_MODULE
# - DATABASE_URL
# - CLOUDINARY_* (all 3)
# - RESEND_API_KEY
# - FROM_EMAIL
# - ML_SERVICE_URL

# Celery Beat (Background Worker)
# --------------------------------
# Needs:
# - PYTHON_VERSION
# - DJANGO_SETTINGS_MODULE
# - DATABASE_URL

# ============================================================================
# Notes
# ============================================================================
# 1. Never commit this file with real values to Git
# 2. Use Render's "Sync" feature to share variables between services
# 3. DATABASE_URL is automatically provided by Render when you link the database
# 4. Generate SECRET_KEY using Django's utility (see comment above)
# 5. Update CORS_ALLOWED_ORIGINS with your actual frontend domain(s)
